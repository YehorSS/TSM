{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.lefrecce.it/*"
        },
        {
          "url": "https://global.api.flixbus.com/*"
        },
        {
          "url": "https://www.ryanair.com/*"
        }
      ]
    },
    "opener:default"
  ]
}