{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TSM",
  "version": "0.1.0",
  "identifier": "com.tsm.italytrips",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TSM — поездки по Италии",
        "width": 1200,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Поезда, автобусы и самолёты по Италии"
  }
}